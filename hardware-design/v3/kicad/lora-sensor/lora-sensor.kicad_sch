		(uuid "0d4faa74-be65-5fbe-badd-928224ecf292")
	)
	(text "U14 takes the ring of a hot plug on its input, which is rated"
		(exclude_from_sim no)
		(at 15 32.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "98c0ea1e-3761-54e0-aae7-8e42d2827741")
	)
	(text "for 20 V, then raises VBUS at 1.3 V/ms and never lets it over"
